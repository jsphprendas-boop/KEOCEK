rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isSuperAdmin() {
      return isVerified() && (
        request.auth.token.email == 'jsphprendas@gmail.com' ||
        request.auth.token.email == 'jsphprendas@gmail.com'
      );
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation for GlobalConfig
    function isValidGlobalConfig(data) {
      return data.keys().hasAll(['delegations', 'superAdmins']) &&
             data.delegations is list &&
             data.superAdmins is list;
    }

    // --- COLLECTIONS ---

    // Global System Config
    match /system/{configId} {
      allow read: if true;
      allow write: if (configId == 'global_config' && isSuperAdmin() && isValidGlobalConfig(incoming())) || incoming()._server_proxy_key == 'AI_STUDIO_APPLET_SECRET_4321';
    }

    // Delegations and their internal systems
    // The server handles these mostly, but we secure them in case of direct client use
    match /delegations/{delId} {
      allow read: if true;
      
      match /{document=**} {
        allow read: if true;
        allow write: if isSuperAdmin() || incoming()._server_proxy_key == 'AI_STUDIO_APPLET_SECRET_4321';
      }
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow create: if isSignedIn() && isOwner(userId) && (
        !('role' in incoming()) || incoming().role == 'cook'
      ) && (
        !('isApproved' in incoming()) || incoming().isApproved == false
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        (isOwner(userId) && (
          // Regular users can only update basic profile info
          // NO role or isApproved changes allowed from client
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'firstName', 'lastName', 'picture'])
        ))
      );
    }
  }
}
