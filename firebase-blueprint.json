{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and delegation assignment",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["SuperAdmin", "DelegationAdmin", "User"] },
        "assignedDelegationId": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "DelegationData": {
      "title": "Delegation Data",
      "description": "Main state for a specific delegation",
      "type": "object",
      "properties": {
        "users": { "type": "array" },
        "products": { "type": "array" },
        "categories": { "type": "array" },
        "movements": { "type": "array" },
        "requests": { "type": "array" },
        "trash": { "type": "array" },
        "supportRecords": { "type": "array" },
        "supportCategories": { "type": "array" },
        "supportProducts": { "type": "array" },
        "settings": { "type": "object" },
        "adminAuditLog": { "type": "array" },
        "gasReports": { "type": "array" },
        "workflows": { "type": "array", "description": "Enterprise workflow instances" },
        "governancePolicies": { "type": "object", "description": "Data governance rules (tags, sensitivity, retention)" }
      }
    },
    "PastHistory": {
      "title": "Past History",
      "description": "Archived records for a delegation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "note": { "type": "string" },
        "movements": { "type": "array" },
        "requests": { "type": "array" }
      }
    },
    "GlobalInfo": {
       "title": "Global Info",
       "description": "List of all active delegations",
       "type": "object",
       "properties": {
         "list": { "type": "array" }
       }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles and RBAC"
    },
    "system/global_config": {
      "schema": "GlobalInfo",
      "description": "Global list of available delegations and super admins"
    },
    "delegations/{delegationId}/system/main_db": {
      "schema": "DelegationData",
      "description": "Main structure for a delegation (categories, products, users, settings)"
    },
    "delegations/{delegationId}/system/main_db_data_1": {
      "schema": "object",
      "description": "Secondary data for a delegation (movements, requests)"
    },
    "delegations/{delegationId}/system/main_db_data_2": {
      "schema": "object",
      "description": "Ternary data for a delegation (audit logs, support records, gas reports)"
    },
    "delegations/{delegationId}/system/trash_db": {
      "schema": "object",
      "description": "Trash archive for a delegation"
    }
  }
}
